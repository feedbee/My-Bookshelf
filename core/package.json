{
  "name": "my-bookshelf",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/src/app.js",
  "scripts": {
    "clean": "rm -rf ./dist/* ",
    "build": "tsc ",
    "test": "npm run build && node --test test/*.test.js",
    "watch-ts": "tsc -w",
    "watch-node": "nodemon dist/app.js",
    "watch": "concurrently -k -p \"[{name}]\" -n \"TypeScript, Node\" -c \"yello.bold, cyan.bold\" \"npm run watch-ts\" \"npm run watch-node\"",
    "start": "node ./dist/app.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feedbee/My-Bookshelf.git"
  },
  "author": "feedbee@gmail.com",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/feedbee/My-Bookshelf/issues"
  },
  "homepage": "https://github.com/feedbee/My-Bookshelf",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-handlebars": "^9.0.1",
    "mongoose": "^9.9.5"
  }
}
